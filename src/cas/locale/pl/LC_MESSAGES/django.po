#: cas/templates/cas/logout.html:5 cas/templates/cas/logout.html:12
#: cas/templates/oidc_provider/end_session_completed.html:7
msgid "Logged out"
msgstr "Wylogowano"

#: cas/templates/cas/logout.html:14
msgid ""
"You have successfully logged out. To ensure that you are logged out of all "
"services, please close your browser."
msgstr ""
"Pomyślnie wylogowano. Zamknij przeglądarkę, aby zapewnić wylogowanie ze "
"wszystkich serwisów."

#: cas/templates/cas/logout.html:17
#, python-format
msgid ""
"You can return to service you came from: <a href=\"%(url)s\">%(url)s</a>"
msgstr "Możesz wrócić do serwisu: <a href=\"%(url)s\">%(url)s</a>."

#: cas/templates/cas/logout.html:21
#, python-format
msgid "You can also <a href=\"%(login_url)s\">login again</a>"
msgstr "Możesz też <a href=\"%(login_url)s\">zalogować się ponownie</a>."

#: cas/templates/oidc_provider/end_session_completed.html:8
msgid "You've been logged out."
msgstr "Wylogowano Cię."

#: cas/templates/oidc_provider/end_session_completed.html:9
msgid "Log in again"
msgstr "Zaloguj się ponownie"

#: cas/templates/oidc_provider/end_session_failed.html:7
msgid "Not logged out"
msgstr "Nie wylogowano"

#: cas/templates/oidc_provider/end_session_failed.html:8
msgid "You're still logged in. You can close this window."
msgstr "Nadal jesteś zalogowany/-a. Możesz zamknąć to okno."

#: cas/templates/oidc_provider/end_session_failed.html:9
msgid "Go to your account"
msgstr "Przejdź do swojego konta"

#: cas/templates/oidc_provider/end_session_prompt.html:8
#: cas/templates/oidc_provider/end_session_prompt.html:16
msgid "Log out"
msgstr "Wyloguj"

#: cas/templates/oidc_provider/end_session_prompt.html:11
#, python-format
msgid "Do you want to log out (you've been using %(name)s)?"
msgstr "Czy chcesz się wylogować (po używaniu %(name)s)?"

#: cas/templates/oidc_provider/end_session_prompt.html:13
msgid "Do you want to log out?"
msgstr "Czy chcesz się wylogować?"

#: cas/templates/oidc_provider/end_session_prompt.html:17
msgid "Cancel"
msgstr "Anuluj"

#: cas/templates/registration/login.html:9
msgid "Login"
msgstr "Zaloguj"

#: cas/templates/registration/login.html:13
msgid "Log me in"
msgstr "Zaloguj mnie"

#: cas/templates/registration/login.html:16
msgid "Forgot password?"
msgstr "Nie pamiętasz hasła?"

#: ftp/admin.py:19
#, python-format
msgid ""
"Password for <strong>%(login)s</strong> set to: <input disabled "
"value=\"%(password)s\">."
msgstr ""
"Hasło dla <strong>%(login)s</strong> ustawione na: <input disabled "
"value=\"%(password)s\">."
